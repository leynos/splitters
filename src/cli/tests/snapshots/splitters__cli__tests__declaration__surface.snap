command splitters
  about: Split one Git branch into smaller, independently reviewable branches.
  arg help: long=help value_names= index=<none> required=false num_args=0..=0 require_equals=false help=Print help (see more with '--help')
  arg version: long=version value_names= index=<none> required=false num_args=0..=0 require_equals=false help=Print version
  command map
    about: Decompose the current branch into fragments and write a manifest.
    arg base: long=base value_names=REF index=<none> required=false num_args=1..=1 require_equals=false help=Base ref to compare against
    arg help: long=help value_names= index=<none> required=false num_args=0..=0 require_equals=false help=Print help
    arg manifest_dir: long=manifest-dir value_names=DIR index=<none> required=false num_args=1..=1 require_equals=false help=Directory that receives the manifest, fragments, and metadata
  command validate
    about: Prove that one proposal can be extracted cleanly.
    arg base: long=base value_names=REF index=<none> required=false num_args=1..=1 require_equals=false help=Base ref to compare against
    arg check: long=check value_names=COMMAND index=<none> required=false num_args=1..=1 require_equals=false help=Command to run in both the candidate and residual worktrees
    arg help: long=help value_names= index=<none> required=false num_args=0..=0 require_equals=false help=Print help
    arg manifest_dir: long=manifest-dir value_names=DIR index=<none> required=false num_args=1..=1 require_equals=false help=Directory holding the manifest to read
    arg proposal: long=<none> value_names=PROPOSAL index=1 required=true num_args=1..=1 require_equals=false help=Identifier of the proposal to validate
  command extract
    about: Move one validated proposal onto a new branch.
    arg base: long=base value_names=REF index=<none> required=false num_args=1..=1 require_equals=false help=Base ref to compare against
    arg branch: long=branch value_names=NAME index=<none> required=false num_args=1..=1 require_equals=false help=Name of the branch that receives the proposal
    arg help: long=help value_names= index=<none> required=false num_args=0..=0 require_equals=false help=Print help
    arg manifest_dir: long=manifest-dir value_names=DIR index=<none> required=false num_args=1..=1 require_equals=false help=Directory holding the manifest to read
    arg proposal: long=<none> value_names=PROPOSAL index=1 required=true num_args=1..=1 require_equals=false help=Identifier of the proposal to extract
    arg publish: long=publish value_names=BOOL index=<none> required=false num_args=0..=1 require_equals=true help=Publish the extracted branch as a pull request after local extraction
